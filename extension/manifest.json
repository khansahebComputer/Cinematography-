{
  "manifest_version": 3,
  "name": "Cinamato AI Studio Clipper",
  "version": "1.0",
  "description": "Clip content and ideas directly into your Cinamato AI Studio projects.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
